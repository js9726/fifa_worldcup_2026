DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
ADMIN_KEY="change-me"
NEXT_PUBLIC_APP_NAME="World Cup 2026 Pools"

# Free token from https://www.football-data.org/client/register
# Used by `npm run sync:results` to auto-pull World Cup scores + final standings.
FOOTBALL_DATA_TOKEN=""
# Optional: defaults to "WC" (FIFA World Cup). Override only for testing other competitions.
# FOOTBALL_DATA_COMP="WC"

# Optional trusted Asian Handicap source.
# Free OddsPapi account: https://oddspapi.io
# Used by `npm run sync:odds`; missing key = clean skip + model fallback.
ODDSPAPI_KEY=""
# Optional comma-separated bookmakers requested from OddsPapi.
# ODDSPAPI_BOOKMAKERS="pinnacle,bet365,draftkings,fanduel"
# Optional preferred bookmaker name when more than one is available.
# ODDSPAPI_BOOKMAKER="pinnacle"
# Free-tier protection. Defaults to once per day.
# ODDSPAPI_ODDS_MIN_INTERVAL_MINUTES="1440"
