DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
ADMIN_KEY="change-me"
NEXT_PUBLIC_APP_NAME="World Cup 2026 Pools"

# Free token from https://www.football-data.org/client/register
# Used by `npm run sync:results` to auto-pull World Cup scores + final standings.
FOOTBALL_DATA_TOKEN=""
# Optional: defaults to "WC" (FIFA World Cup). Override only for testing other competitions.
# FOOTBALL_DATA_COMP="WC"

# Optional trusted Asian Handicap source.
# Free API-Football account: https://dashboard.api-football.com
# Used by `npm run sync:odds`; missing key = clean skip + model fallback.
API_FOOTBALL_KEY=""
# Defaults: FIFA World Cup league=1, season=2026.
# API_FOOTBALL_LEAGUE="1"
# API_FOOTBALL_SEASON="2026"
# Optional comma-separated pre-match Asian Handicap bet IDs if discovery changes.
# API_FOOTBALL_AH_BET_IDS=""
# Optional preferred bookmaker name, e.g. "Pinnacle" if available.
# API_FOOTBALL_BOOKMAKER=""
# Free-tier protection. API-Football pre-match odds update around every 3 hours.
# API_FOOTBALL_ODDS_MIN_INTERVAL_MINUTES="180"
