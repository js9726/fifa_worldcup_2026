DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
ADMIN_KEY="change-me"
NEXT_PUBLIC_APP_NAME="World Cup 2026 Pools"

# Free token from https://www.football-data.org/client/register
# Used by `npm run sync:results` to auto-pull World Cup scores + final standings.
FOOTBALL_DATA_TOKEN=""
# Optional: defaults to "WC" (FIFA World Cup). Override only for testing other competitions.
# FOOTBALL_DATA_COMP="WC"

# Optional trusted Asian Handicap source.
# Used by `npm run sync:odds`; missing key = clean skip + model fallback.
SPORTSDATAIO_API_KEY=""
# SportsDataIO soccer guide lists FIFA World Cup as competition ID 21.
SPORTSDATAIO_COMPETITION_ID="21"
# Optional override if SportsDataIO assigns your account a different odds endpoint.
# SPORTSDATAIO_ODDS_URL="https://api.sportsdata.io/v4/soccer/odds/json/BettingEventsByCompetition/{competitionId}?include=available"
# Optional preferred sportsbook name, e.g. "Pinnacle" if available in your plan.
# SPORTSDATAIO_BOOKMAKER=""
